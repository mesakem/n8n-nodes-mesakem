{
	"name": "n8n-nodes-mesakem",
	"version": "0.1.0",
	"description": "n8n nodes for Mesakem, the AI meeting notetaker: instant triggers for summaries, transcripts, meetings and tasks, plus actions for meetings, tasks, documents and the notetaker.",
	"license": "MIT",
	"homepage": "https://mesakem.com/en/developers",
	"keywords": [
		"n8n-community-node-package",
		"mesakem",
		"meeting notes",
		"meeting summary",
		"transcription",
		"notetaker"
	],
	"author": {
		"name": "Mesakem",
		"email": "support@mesakem.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mesakem/n8n-nodes-mesakem.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:tsc": "tsc -p tsconfig.json",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.json && node --test",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MesakemApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Mesakem/Mesakem.node.js",
			"dist/nodes/MesakemTrigger/MesakemTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.5",
		"@types/node": "^20.19.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
